# Lotz settings. Copy to .env and fill in. Never commit .env.
# `pnpm localnet` writes a working local .env for you.

# --- Solana
# Helius (or any) RPC. The key stays on the server: browsers go through /api/rpc.
RPC_URL=http://127.0.0.1:18899
# Websocket for the indexer's logsSubscribe (defaults to RPC_URL with ws:// and port+1).
RPC_WS_URL=ws://127.0.0.1:18900
PROGRAM_ID=
TOKEN_MINT=
TREASURY=
# Address lookup table holding the deployment's fixed accounts (created by the setup script).
LOOKUP_TABLE=
# Wallet(s) allowed into /admin, comma-separated.
ADMIN_WALLET=
# localnet | devnet | mainnet-beta (explorer links, labels)
NEXT_PUBLIC_CLUSTER=localnet
# Optional: let browsers call an RPC directly instead of /api/rpc (use a domain-restricted key).
NEXT_PUBLIC_RPC_URL=
PRIORITY_FEE_MICROLAMPORTS=0

# --- Database
DATABASE_URL=postgres://127.0.0.1:5433/lotz

# --- Object storage: local (dev) or s3 (Cloudflare R2 / AWS S3 behind a CDN)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../.data/storage
STORAGE_PUBLIC_URL=http://localhost:3000/media
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Indexer
INDEXER_PORT=4100
HELIUS_WEBHOOK_SECRET=
POLL_INTERVAL_MS=15000

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# At least 32 random characters (admin session cookies).
SESSION_SECRET=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_SOURCE_URL=
