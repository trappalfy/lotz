{
  "name": "@lotz/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Listens to the program, keeps Postgres in sync, renders the board, notifies the site.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lotz/brand": "workspace:*",
    "@lotz/db": "workspace:*",
    "@lotz/imaging": "workspace:*",
    "@lotz/moderation": "workspace:*",
    "@lotz/sdk": "workspace:*",
    "@lotz/storage": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@lotz/local": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
