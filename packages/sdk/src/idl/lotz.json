    {
      "name": "Config",
      "docs": [
        "PDA `[\"config\"]`. Launch parameters are written once by `initialize` and never change; only the counters and",
        "`paused` move afterwards."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "docs": [
              "Can pause and resume new purchases, nothing else. No access to the vaults."
            ],
            "type": "pubkey"
          },
