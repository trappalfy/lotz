          },
          {
            "name": "x",
            "docs": [
              "Rectangle in lots: `x, y` in `0..100`, `w, h` in `1..=max_rect`."
            ],
            "type": "u8"
          },
          {
            "name": "y",
            "type": "u8"
          },
          {
            "name": "w",
            "type": "u8"
          },
          {
            "name": "h",
            "type": "u8"
          },
          {
            "name": "epoch",
