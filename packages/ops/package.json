{
  "name": "@lotz/ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owner tools for a real cluster: launch plan (dry run by default), initialize, shards, lookup table, pause.",
  "scripts": {
    "launch": "tsx src/launch.ts",
    "pause": "tsx src/pause.ts",
    "import-key": "tsx src/import-key.ts",
    "check-mainnet": "tsx src/check-mainnet.ts",
    "lock-stats": "tsx src/lock-stats.ts",
    "wind-down": "tsx src/wind-down.ts",
    "hosting": "tsx src/hosting.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lotz/db": "workspace:*",
    "@lotz/sdk": "workspace:*",
    "@lotz/storage": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "bs58": "6.0.0",
    "@solana/web3.js": "1.99.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@lotz/local": "workspace:*"
  }
}
